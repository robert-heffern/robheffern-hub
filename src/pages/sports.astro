---
import Base from "../layouts/Base.astro";

const sports = [
  { name: "Baseball", emoji: "⚾", blurb: "150 years of games. Find the one most like tonight's.", href: "https://sports.palaich.net" },
  { name: "Hockey", emoji: "🏒", blurb: "Shazam for NHL games — a century of hockey, searched live.", href: "https://hockey.palaich.net" },
  { name: "Basketball", emoji: "🏀", blurb: "72,000 NBA games. Which one does this one rhyme with?", href: "https://nba.palaich.net" },
  { name: "Soccer", emoji: "⚽", blurb: "The Premier League, matched against its own history.", href: "https://soccer.palaich.net" },
  { name: "College Football", emoji: "🏈", blurb: "87,000 games back to 1869. Which one does this one echo?", href: "https://cfb.palaich.net" },
  { name: "NFL", emoji: "🏈", blurb: "18,234 games back to 1920. Find this Sunday's twin.", href: "https://nfl.palaich.net" },
  { name: "NRL", emoji: "🏉", blurb: "A century of rugby league — 14,951 games since 1908, matched live.", href: "https://nrl.palaich.net" },
];

const coming = ["AFL", "Figure Skating"];
---
<Base title="Sports Similarity — Rob Heffern" description="Which game in history most resembles the one you're watching right now?">
  <main class="wrap">
    <p class="crumb"><a href="/">← the cabinet</a></p>
    <header class="room-head">
      <p class="kicker">Sports Similarity</p>
      <h1>Which game in history is this one?</h1>
      <p class="lede">
        Point one of these at a game happening right now and it searches the whole
        recorded history of the sport for the game — or season — most like it. Pick a sport.
      </p>
    </header>

    <section id="equinox" class="equinox" hidden>
      <span class="eq-dot" aria-hidden="true"></span>
      <span class="eq-main">
        <strong id="eq-title"></strong>
        <span id="eq-sub" class="eq-sub"></span>
      </span>
    </section>

    <a class="zodiac-card" href="/sports/zodiac/">
      <span class="zc-emoji" aria-hidden="true">🪐</span>
      <span class="zc-body">
        <span class="zc-name">The Sporting Zodiac</span>
        <span class="zc-blurb" id="zc-next">The year as a wheel — the four leagues' seasons, the daily rhythm of games, and the rare alignments.</span>
      </span>
      <span class="go">enter →</span>
    </a>

    <section class="grid">
      {sports.map((s) => (
        <a class="sport" href={s.href}>
          <span class="emoji">{s.emoji}</span>
          <span class="body">
            <span class="name">{s.name}</span>
            <span class="blurb">{s.blurb}</span>
          </span>
          <span class="go">open →</span>
        </a>
      ))}
    </section>

    <p class="coming">More on the workbench: {coming.join(" · ")}.</p>
  </main>

  <style>
    .crumb { font-family: var(--sans); font-size: .8rem; margin: 0 0 2rem; }
    .room-head { margin-bottom: 2.5rem; }
    .kicker { font-family: var(--sans); text-transform: uppercase; letter-spacing: .28em; font-size: .72rem; color: var(--muted); margin: 0 0 .5rem; }
    h1 { font-size: clamp(1.8rem, 4vw, 2.6rem); font-weight: 500; margin: 0 0 1rem; }
    .lede { color: var(--muted); max-width: 36rem; font-size: 1.1rem; }

    .equinox { display: flex; align-items: center; gap: .85rem; margin: 0 0 1rem; padding: .85rem 1.1rem; border: 1px solid var(--line); border-radius: 10px; background: var(--panel); font-family: var(--sans); }
    .equinox .eq-dot { width: .6rem; height: .6rem; border-radius: 50%; background: var(--gold); flex: none; }
    .equinox .eq-main { display: flex; flex-direction: column; gap: .15rem; }
    .equinox #eq-title { font-size: .98rem; font-weight: 600; }
    .equinox .eq-sub { font-size: .82rem; color: var(--muted); }
    .equinox.is-equinox { border-color: var(--gold); box-shadow: inset 0 0 0 1px var(--gold); }
    .equinox.is-equinox .eq-dot { box-shadow: 0 0 10px var(--gold); animation: eqpulse 2s ease-in-out infinite; }
    .equinox.is-super { background: linear-gradient(90deg, color-mix(in srgb, var(--gold) 16%, var(--panel)), var(--panel)); }
    .equinox.is-super #eq-title { color: var(--gold); }
    @keyframes eqpulse { 0%,100% { opacity: 1; } 50% { opacity: .35; } }

    .zodiac-card {
      display: flex; align-items: center; gap: 1rem; margin: 0 0 2rem;
      padding: 1.3rem 1.4rem; color: var(--ink); border-radius: 10px;
      border: 1px solid color-mix(in srgb, var(--gold) 45%, var(--line));
      background: linear-gradient(90deg, color-mix(in srgb, var(--gold) 10%, var(--panel)), var(--panel));
      transition: transform .15s ease, border-color .15s ease;
    }
    .zodiac-card:hover { transform: translateY(-3px); border-color: var(--gold); text-decoration: none; }
    .zc-emoji { font-size: 2.2rem; line-height: 1; }
    .zc-body { display: flex; flex-direction: column; flex: 1; }
    .zc-name { font-size: 1.3rem; color: var(--gold); }
    .zc-blurb { color: var(--muted); font-size: .92rem; margin-top: .2rem; }

    .grid { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr)); }
    .sport { display: flex; align-items: center; gap: 1rem; background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 1.3rem 1.4rem; color: var(--ink); transition: transform .15s ease, border-color .15s ease; }
    .sport:hover { transform: translateY(-3px); border-color: var(--gold); text-decoration: none; }
    .emoji { font-size: 2.2rem; line-height: 1; }
    .body { display: flex; flex-direction: column; flex: 1; }
    .name { font-size: 1.3rem; }
    .blurb { color: var(--muted); font-size: .92rem; margin-top: .2rem; }
    .go { font-family: var(--sans); font-size: .72rem; color: var(--gold); white-space: nowrap; }
    .coming { color: var(--muted); font-family: var(--sans); font-size: .85rem; margin-top: 2.5rem; text-align: center; }
  </style>

  <script is:inline>
    /* Equinox strip + Zodiac card teaser — both read sky.json so they agree with the wheel. */
    (function () {
      var SKY = "https://zodiac.palaich.net/sky.json";
      function etToday(){ return new Intl.DateTimeFormat("en-CA",{timeZone:"America/New_York",year:"numeric",month:"2-digit",day:"2-digit"}).format(new Date()); }
      function label(ds){ var d=new Date(ds+"T12:00:00"); return d.toLocaleDateString("en-US",{weekday:"long",month:"short",day:"numeric"}); }
      function shortLabel(ds){ var d=new Date(ds+"T12:00:00"); return d.toLocaleDateString("en-US",{month:"long",day:"numeric"}); }

      fetch(SKY).then(function(r){ if(!r.ok) throw 0; return r.json(); }).then(function(data){
        var TODAY=etToday();
        var ev=data.events||{};
        var rows={}; (data.days||[]).forEach(function(d){ rows[d.date]=d; });
        var eqset={}; (ev.equinoxes||[]).forEach(function(d){eqset[d]=1;});
        var supset={}; (ev.superEquinoxes||[]).forEach(function(d){supset[d]=1;});

        // ----- Equinox strip: today, else imminent (<= 7 days) -----
        function showStrip(cls,title,sub){ var el=document.getElementById("equinox"); if(!el)return; el.className="equinox "+cls; document.getElementById("eq-title").textContent=title; document.getElementById("eq-sub").textContent=sub; el.hidden=false; }
        if(eqset[TODAY]){
          if(supset[TODAY]) showStrip("is-equinox is-super","🌟 Super Equinox — today","All four major leagues and college football are playing.");
          else showStrip("is-equinox","⚡ Sports Equinox — today","All four major leagues are playing at once.");
        } else {
          var nextEq=(ev.equinoxes||[]).filter(function(d){return d>TODAY;}).sort()[0];
          if(nextEq){ var dd=Math.round((new Date(nextEq+"T12:00:00")-new Date(TODAY+"T12:00:00"))/86400000);
            if(dd<=7){ var sup=supset[nextEq];
              showStrip(sup?"is-upcoming is-super":"is-upcoming",(sup?"🌟 Super Equinox ":"⚡ Sports Equinox ")+(dd===1?"tomorrow":"in "+dd+" days"), label(nextEq)+" — all four major leagues scheduled"+(sup?", plus college football":"")+".");
            }
          }
        }

        // ----- Zodiac card teaser: next celestial event, any distance -----
        var now=document.getElementById("zc-next");
        if(now){
          var up=[];
          (ev.equinoxes||[]).forEach(function(d){ if(d>TODAY) up.push([d,supset[d]?"a Super Equinox":"a Sports Equinox"]); });
          if(ev.perihelion&&ev.perihelion.date>TODAY) up.push([ev.perihelion.date,"Perihelion"]);
          (ev.eclipses||[]).forEach(function(d){ if(d>TODAY) up.push([d,"a Total Eclipse"]); });
          up.sort(function(a,b){return a[0]<b[0]?-1:1;});
          if(up.length){ var dd2=Math.round((new Date(up[0][0]+"T12:00:00")-new Date(TODAY+"T12:00:00"))/86400000);
            now.textContent="Next: "+up[0][1]+" in "+dd2+" day"+(dd2===1?"":"s")+" ("+shortLabel(up[0][0])+"). Step into the wheel →";
          }
        }
      }).catch(function(){ /* leave strip hidden, card keeps its default blurb */ });
    })();
  </script>
</Base>
