---
import Base from "../layouts/Base.astro";

const sports = [
  { name: "Baseball", emoji: "⚾", blurb: "150 years of games. Find the one most like tonight's.", href: "https://sports.palaich.net", live: true },
  { name: "Hockey", emoji: "🏒", blurb: "Shazam for NHL games — a century of hockey, searched live.", href: "https://hockey.palaich.net", live: true },
  { name: "Basketball", emoji: "🏀", blurb: "72,000 NBA games. Which one does this one rhyme with?", href: "https://nba.palaich.net", live: true },
  { name: "Soccer", emoji: "⚽", blurb: "The Premier League, matched against its own history.", href: "https://soccer.palaich.net", live: true },
  { name: "College Football", emoji: "🏈", blurb: "87,000 games back to 1869. Which one does this one echo?", href: "https://cfb.palaich.net", live: true },
  { name: "NFL", emoji: "🏈", blurb: "18,234 games back to 1920. Find this Sunday's twin.", href: "https://nfl.palaich.net", live: true },
];

const coming = ["NRL", "AFL", "Figure Skating"];
---
<Base title="Sports Similarity — Rob Heffern" description="Which game in history most resembles the one you're watching right now?">
  <main class="wrap">
    <p class="crumb"><a href="/">← the cabinet</a></p>
    <header class="room-head">
      <p class="kicker">Sports Similarity</p>
      <h1>Which game in history is this one?</h1>
      <p class="lede">
        Point one of these at a game happening right now and it searches the whole
        recorded history of the sport for the game — or season — most like it. Pick a sport.
      </p>
    </header>

    <section id="equinox" class="equinox" hidden>
      <span class="eq-dot" aria-hidden="true"></span>
      <span class="eq-main">
        <strong id="eq-title"></strong>
        <span id="eq-sub" class="eq-sub"></span>
      </span>
    </section>

    <!-- The Sporting Zodiac -->
    <section class="zodiac">
      <div class="z-head">
        <p class="z-kicker">The Sporting Zodiac</p>
        <p class="z-sub">The year as the four major leagues keep it — the wheel we plant and harvest by. <span id="z-now"></span></p>
      </div>
      <div id="z-wheel" class="z-wheel"><p class="z-note">Reading the sky…</p></div>
      <div class="z-legend" id="z-legend"></div>
    </section>

    <section class="grid">
      {sports.map((s) => (
        <a class="sport" href={s.href}>
          <span class="emoji">{s.emoji}</span>
          <span class="body">
            <span class="name">{s.name}</span>
            <span class="blurb">{s.blurb}</span>
          </span>
          <span class="go">open →</span>
        </a>
      ))}
    </section>

    <p class="coming">More on the workbench: {coming.join(" · ")}.</p>
  </main>

  <style>
    .crumb { font-family: var(--sans); font-size: .8rem; margin: 0 0 2rem; }
    .room-head { margin-bottom: 2.5rem; }
    .kicker { font-family: var(--sans); text-transform: uppercase; letter-spacing: .28em; font-size: .72rem; color: var(--muted); margin: 0 0 .5rem; }
    h1 { font-size: clamp(1.8rem, 4vw, 2.6rem); font-weight: 500; margin: 0 0 1rem; }
    .lede { color: var(--muted); max-width: 36rem; font-size: 1.1rem; }

    .equinox { display: flex; align-items: center; gap: .85rem; margin: 0 0 2rem; padding: .85rem 1.1rem; border: 1px solid var(--line); border-radius: 10px; background: var(--panel); font-family: var(--sans); }
    .equinox .eq-dot { width: .6rem; height: .6rem; border-radius: 50%; background: var(--muted); flex: none; }
    .equinox .eq-main { display: flex; flex-direction: column; gap: .15rem; }
    .equinox #eq-title { font-size: .98rem; font-weight: 600; }
    .equinox .eq-sub { font-size: .82rem; color: var(--muted); }
    .equinox.is-upcoming .eq-dot { background: var(--gold); }
    .equinox.is-equinox { border-color: var(--gold); box-shadow: inset 0 0 0 1px var(--gold); }
    .equinox.is-equinox .eq-dot { background: var(--gold); box-shadow: 0 0 10px var(--gold); animation: eqpulse 2s ease-in-out infinite; }
    .equinox.is-super { background: linear-gradient(90deg, color-mix(in srgb, var(--gold) 16%, var(--panel)), var(--panel)); }
    .equinox.is-super #eq-title { color: var(--gold); }
    @keyframes eqpulse { 0%,100% { opacity: 1; } 50% { opacity: .35; } }

    .zodiac { margin: 0 0 3rem; padding: 1.6rem 1.4rem 1.2rem; border: 1px solid var(--line); border-radius: 12px; background: var(--panel); }
    .z-kicker { font-family: var(--sans); text-transform: uppercase; letter-spacing: .22em; font-size: .72rem; color: var(--gold); margin: 0 0 .4rem; }
    .z-sub { color: var(--muted); font-size: .95rem; margin: 0 0 1rem; max-width: 42rem; }
    .z-sub #z-now { color: var(--ink); }
    .z-wheel { display: flex; justify-content: center; }
    .z-wheel svg { width: 100%; max-width: 560px; height: auto; }
    .z-note { color: var(--muted); font-family: var(--sans); font-size: .85rem; padding: 2rem; }
    .z-legend { display: flex; flex-wrap: wrap; gap: .4rem 1.1rem; justify-content: center; margin-top: .8rem; font-family: var(--sans); font-size: .8rem; color: var(--muted); }
    .z-legend span { display: inline-flex; align-items: center; gap: .4rem; }
    .z-legend i { width: .7rem; height: .7rem; border-radius: 2px; display: inline-block; }

    .grid { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr)); }
    .sport { display: flex; align-items: center; gap: 1rem; background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 1.3rem 1.4rem; color: var(--ink); transition: transform .15s ease, border-color .15s ease; }
    .sport:hover { transform: translateY(-3px); border-color: var(--gold); text-decoration: none; }
    .emoji { font-size: 2.2rem; line-height: 1; }
    .body { display: flex; flex-direction: column; flex: 1; }
    .name { font-size: 1.3rem; }
    .blurb { color: var(--muted); font-size: .92rem; margin-top: .2rem; }
    .go { font-family: var(--sans); font-size: .72rem; color: var(--gold); white-space: nowrap; }
    .coming { color: var(--muted); font-family: var(--sans); font-size: .85rem; margin-top: 2.5rem; text-align: center; }
  </style>

  <script is:inline>
    /* ===== Equinox strip — live ESPN, real games only (season type 2 & 3) ===== */
    (function () {
      var BIG = { mlb: "baseball/mlb", nfl: "football/nfl", nba: "basketball/nba", nhl: "hockey/nhl" };
      var CFB = "football/college-football";
      function etYMD(o){ return new Intl.DateTimeFormat("en-CA",{timeZone:"America/New_York",year:"numeric",month:"2-digit",day:"2-digit"}).format(new Date(Date.now()+o*86400000)).replace(/-/g,""); }
      function etLabel(y){ var d=new Date(y.slice(0,4)+"-"+y.slice(4,6)+"-"+y.slice(6,8)+"T12:00:00"); return d.toLocaleDateString("en-US",{weekday:"long",month:"short",day:"numeric"}); }
      var TODAY=etYMD(0);
      function slate(path,ymd){
        var key="eq:"+path+":"+ymd;
        if(ymd!==TODAY){ try{var c=sessionStorage.getItem(key); if(c) return Promise.resolve(JSON.parse(c));}catch(e){} }
        var ctrl=new AbortController(), t=setTimeout(function(){ctrl.abort();},6000);
        return fetch("https://site.api.espn.com/apis/site/v2/sports/"+path+"/scoreboard?dates="+ymd,{signal:ctrl.signal})
          .then(function(r){clearTimeout(t); if(!r.ok) throw 0; return r.json();})
          .then(function(j){
            var ev=(j&&j.events)||[], cnt=0, live=0;
            for(var i=0;i<ev.length;i++){
              var st=(ev[i].season||{}).type;
              if(st!==2&&st!==3) continue;              /* real games only */
              cnt++;
              if((((ev[i].status||{}).type||{}).state)==="in") live++;
            }
            var out={count:cnt,live:live,ok:true};
            if(ymd!==TODAY){try{sessionStorage.setItem(key,JSON.stringify(out));}catch(e){}}
            return out;
          })
          .catch(function(){clearTimeout(t); return {count:0,live:0,ok:false};});
      }
      function show(cls,title,sub){ var el=document.getElementById("equinox"); if(!el)return; el.className="equinox "+cls; document.getElementById("eq-title").textContent=title; document.getElementById("eq-sub").textContent=sub; el.hidden=false; }
      Promise.all([slate(BIG.mlb,TODAY),slate(BIG.nfl,TODAY),slate(BIG.nba,TODAY),slate(BIG.nhl,TODAY),slate(CFB,TODAY)]).then(function(r){
        var mlb=r[0],nfl=r[1],nba=r[2],nhl=r[3],cfb=r[4];
        if(!(mlb.ok||nfl.ok||nba.ok||nhl.ok)) return;
        var big4=mlb.count>0&&nfl.count>0&&nba.count>0&&nhl.count>0;
        var sup=big4&&cfb.count>0;
        var liveNow=mlb.live+nfl.live+nba.live+nhl.live+(sup?cfb.live:0);
        var ls=liveNow>0?" "+liveNow+" game"+(liveNow===1?"":"s")+" live right now.":"";
        if(sup){show("is-equinox is-super","🌟 Super Equinox — today","All four major leagues and college football are playing."+ls);return;}
        if(big4){show("is-equinox","⚡ Sports Equinox — today","All four major leagues are playing at once."+ls);return;}
        look(1);
      });
      function look(off){ if(off>7)return; var ymd=etYMD(off);
        slate(BIG.nfl,ymd).then(function(n){ if(!n.ok||n.count===0) return look(off+1);
          Promise.all([slate(BIG.mlb,ymd),slate(BIG.nba,ymd),slate(BIG.nhl,ymd)]).then(function(x){
            if(x[0].count>0&&x[1].count>0&&x[2].count>0){ slate(CFB,ymd).then(function(cf){
              var sup=cf.count>0, when=off===1?"tomorrow":"in "+off+" days", lineup="MLB · NFL · NBA · NHL"+(sup?" · CFB":"");
              show(sup?"is-upcoming is-super":"is-upcoming",(sup?"🌟 Super Equinox ":"⚡ Sports Equinox ")+when, etLabel(ymd)+" — "+lineup+" all scheduled.");
            }); } else look(off+1);
          });
        });
      }
    })();

    /* ===== The Sporting Zodiac wheel ===== */
    (function () {
      var SKY = "https://zodiac.palaich.net/sky.json";
      var SVGNS = "http://www.w3.org/2000/svg";
      var ORDER = ["mlb", "nhl", "nba", "nfl"];   // spike stack, inner→outer
      var wheel = document.getElementById("z-wheel");
      if (!wheel) return;

      fetch(SKY).then(function (r) { if (!r.ok) throw 0; return r.json(); })
        .then(render)
        .catch(function () { wheel.innerHTML = '<p class="z-note">The sky is clouded over just now.</p>'; });

      function render(data) {
        var days = data.days || [];
        if (!days.length) { wheel.innerHTML = '<p class="z-note">No sky data yet.</p>'; return; }
        var idx = {}; days.forEach(function (d, i) { idx[d.date] = i; });
        var N = days.length;
        var todayIdx = (data.today in idx) ? idx[data.today] : 0;
        var maxTot = 1; days.forEach(function (d) { if (d.total > maxTot) maxTot = d.total; });

        var SZ = 560, cx = SZ / 2, cy = SZ / 2;
        var R_RIM = 176;                        // the calendar ring
        var BAND = { mlb: 168, nhl: 160, nba: 152, nfl: 144 }; // season arcs inward
        var SPIKE0 = 180, SPIKE_MAX = 64;       // volume spikes grow outward
        var scale = SPIKE_MAX / maxTot;

        function ang(i) { return -90 + (i - todayIdx) * (360 / N); }     // today at top, degrees
        function rad(a) { return a * Math.PI / 180; }
        function pol(a, r) { return [cx + r * Math.cos(rad(a)), cy + r * Math.sin(rad(a))]; }
        function arc(a0, a1, r) {
          var large = ((a1 - a0) % 360 + 360) % 360 > 180 ? 1 : 0;
          var p0 = pol(a0, r), p1 = pol(a1, r);
          return "M " + p0[0].toFixed(1) + " " + p0[1].toFixed(1) + " A " + r + " " + r + " 0 " + large + " 1 " + p1[0].toFixed(1) + " " + p1[1].toFixed(1);
        }
        function el(name, attrs, title) {
          var e = document.createElementNS(SVGNS, name);
          for (var k in attrs) e.setAttribute(k, attrs[k]);
          if (title) { var t = document.createElementNS(SVGNS, "title"); t.textContent = title; e.appendChild(t); }
          return e;
        }

        var svg = el("svg", { viewBox: "0 0 " + SZ + " " + SZ, role: "img", "aria-label": "The sporting year as a wheel" });
        var muted = "#a99a83", line = "#352e26", gold = "#c8a24a", ink = "#ece3d4";

        // faint base ring
        svg.appendChild(el("circle", { cx: cx, cy: cy, r: R_RIM, fill: "none", stroke: line, "stroke-width": 1 }));

        // month ticks + labels
        for (var i = 0; i < N; i++) {
          var dt = new Date(days[i].date + "T12:00:00");
          if (dt.getDate() === 1) {
            var a = ang(i), o = pol(a, R_RIM), o2 = pol(a, R_RIM + 6), lp = pol(a, SPIKE0 + SPIKE_MAX + 20);
            svg.appendChild(el("line", { x1: o[0], y1: o[1], x2: o2[0], y2: o2[1], stroke: muted, "stroke-width": 1, opacity: .5 }));
            var mt = el("text", { x: lp[0].toFixed(1), y: lp[1].toFixed(1), "text-anchor": "middle", "dominant-baseline": "middle", "font-family": "var(--sans)", "font-size": 9, fill: muted, opacity: .7 });
            mt.textContent = dt.toLocaleDateString("en-US", { month: "short" });
            svg.appendChild(mt);
          }
        }

        // season bands (which sport is in season)
        ORDER.forEach(function (lg) {
          var L = data.leagues[lg]; if (!L) return;
          (L.seasons || []).forEach(function (s) {
            if (!(s.start in idx) || !(s.end in idx)) return;
            svg.appendChild(el("path", { d: arc(ang(idx[s.start]), ang(idx[s.end]), BAND[lg]), fill: "none", stroke: L.color, "stroke-width": 5, "stroke-linecap": "round", opacity: .5 },
              L.label + " season"));
          });
        });

        // daily volume spikes, stacked by league outward
        days.forEach(function (d, i) {
          if (!d.total) return;
          var a = ang(i), past = d.date < data.today, r = SPIKE0;
          ORDER.forEach(function (lg) {
            var c = d[lg] || 0; if (!c) return;
            var len = c * scale, p0 = pol(a, r), p1 = pol(a, r + len);
            svg.appendChild(el("line", { x1: p0[0].toFixed(1), y1: p0[1].toFixed(1), x2: p1[0].toFixed(1), y2: p1[1].toFixed(1), stroke: data.leagues[lg].color, "stroke-width": 1.4, "stroke-linecap": "round", opacity: past ? .9 : .4 },
              d.date + " — " + d.total + " games"));
            r += len;
          });
        });

        // celestial glyphs on the rim
        var ev = data.events || {};
        (ev.eclipses || []).forEach(function (dte) { if (dte in idx) { var p = pol(ang(idx[dte]), R_RIM); svg.appendChild(el("circle", { cx: p[0].toFixed(1), cy: p[1].toFixed(1), r: 3, fill: "#14110f", stroke: muted, "stroke-width": 1 }, "Total Eclipse — no games")); } });
        (ev.equinoxes || []).forEach(function (dte) { if (dte in idx) { var sup = (ev.superEquinoxes || []).indexOf(dte) >= 0; var p = pol(ang(idx[dte]), R_RIM); svg.appendChild(el("circle", { cx: p[0].toFixed(1), cy: p[1].toFixed(1), r: sup ? 4.5 : 3.2, fill: gold, stroke: sup ? ink : "none", "stroke-width": sup ? 1 : 0 }, (sup ? "Super Equinox" : "Sports Equinox") + " — " + dte)); } });
        (ev.conjunctions || []).forEach(function (c) { if (c.date in idx) { var p = pol(ang(idx[c.date]), R_RIM); svg.appendChild(el("circle", { cx: p[0].toFixed(1), cy: p[1].toFixed(1), r: 3.2, fill: "none", stroke: gold, "stroke-width": 1.4 }, "Conjunction — " + c.leagues.join(" + "))); } });

        // Perihelion — a little sunburst + label
        var per = ev.perihelion;
        if (per && per.date in idx) {
          var pa = ang(idx[per.date]);
          for (var k = 0; k < 8; k++) { var aa = k * 45, s0 = pol(pa, R_RIM), c2 = [s0[0] + 6 * Math.cos(rad(aa)), s0[1] + 6 * Math.sin(rad(aa))]; }
          var sp = pol(pa, R_RIM);
          svg.appendChild(el("circle", { cx: sp[0].toFixed(1), cy: sp[1].toFixed(1), r: 5.5, fill: gold }, "Perihelion — the fullest sky of the year (" + per.count + " games, " + per.date + ")"));
          svg.appendChild(el("circle", { cx: sp[0].toFixed(1), cy: sp[1].toFixed(1), r: 9, fill: "none", stroke: gold, "stroke-width": 1, opacity: .6 }));
        }

        // First / Last Light ticks per league
        ORDER.forEach(function (lg) {
          var L = data.leagues[lg]; if (!L) return;
          [["firstLight", "First Light"], ["lastLight", "Last Light"]].forEach(function (pair) {
            var dte = L[pair[0]]; if (dte && dte in idx) { var p0 = pol(ang(idx[dte]), BAND[lg] - 4), p1 = pol(ang(idx[dte]), BAND[lg] + 4); svg.appendChild(el("line", { x1: p0[0].toFixed(1), y1: p0[1].toFixed(1), x2: p1[0].toFixed(1), y2: p1[1].toFixed(1), stroke: L.color, "stroke-width": 2 }, L.label + " " + pair[1] + " — " + dte)); }
          });
        });

        // TODAY marker
        var tp0 = pol(-90, R_RIM - 30), tp1 = pol(-90, SPIKE0 + SPIKE_MAX + 6);
        svg.appendChild(el("line", { x1: tp0[0], y1: tp0[1], x2: tp1[0], y2: tp1[1], stroke: ink, "stroke-width": 1, opacity: .5, "stroke-dasharray": "2 3" }));
        var tl = el("text", { x: cx, y: cy - (SPIKE0 + SPIKE_MAX + 16), "text-anchor": "middle", "font-family": "var(--sans)", "font-size": 10, fill: ink, "letter-spacing": "1.5" });
        tl.textContent = "TODAY"; svg.appendChild(tl);

        // center label
        var c1 = el("text", { x: cx, y: cy - 6, "text-anchor": "middle", "font-family": "var(--serif)", "font-size": 15, fill: ink });
        c1.textContent = new Date(data.today + "T12:00:00").toLocaleDateString("en-US", { month: "long", day: "numeric" });
        svg.appendChild(c1);
        var c2 = el("text", { x: cx, y: cy + 14, "text-anchor": "middle", "font-family": "var(--sans)", "font-size": 9, fill: muted, "letter-spacing": "1" });
        c2.textContent = new Date(data.today + "T12:00:00").getFullYear();
        svg.appendChild(c2);

        wheel.innerHTML = ""; wheel.appendChild(svg);

        // legend
        var leg = document.getElementById("z-legend");
        if (leg) {
          leg.innerHTML = "";
          ORDER.forEach(function (lg) { var L = data.leagues[lg]; if (!L) return; var s = document.createElement("span"); s.innerHTML = '<i style="background:' + L.color + '"></i>' + L.label; leg.appendChild(s); });
          var se = document.createElement("span"); se.innerHTML = '<i style="background:' + gold + ';border-radius:50%"></i>Equinox'; leg.appendChild(se);
          var pe = document.createElement("span"); pe.innerHTML = '<i style="background:' + gold + ';border-radius:50%;box-shadow:0 0 0 2px ' + gold + '33"></i>Perihelion'; leg.appendChild(pe);
          var ec = document.createElement("span"); ec.innerHTML = '<i style="background:#14110f;border:1px solid ' + muted + ';border-radius:50%"></i>Eclipse'; leg.appendChild(ec);
        }

        // "next event" summary line
        var now = document.getElementById("z-now");
        if (now) {
          var today = days[todayIdx] || { total: 0 };
          var lit = ORDER.filter(function (lg) { return (today[lg] || 0) > 0; }).length;
          var upcoming = [];
          (ev.equinoxes || []).forEach(function (d) { if (d > data.today) upcoming.push([d, "a Sports Equinox"]); });
          if (per && per.date > data.today) upcoming.push([per.date, "Perihelion"]);
          (ev.eclipses || []).forEach(function (d) { if (d > data.today) upcoming.push([d, "a Total Eclipse"]); });
          upcoming.sort(function (a, b) { return a[0] < b[0] ? -1 : 1; });
          var txt = "Today: " + lit + " of 4 leagues lit, " + (today.total || 0) + " games.";
          if (upcoming.length) {
            var nd = new Date(upcoming[0][0] + "T12:00:00");
            var ddays = Math.round((nd - new Date(data.today + "T12:00:00")) / 86400000);
            txt += " Next, " + upcoming[0][1] + " in " + ddays + " day" + (ddays === 1 ? "" : "s") + " (" + nd.toLocaleDateString("en-US", { month: "short", day: "numeric" }) + ").";
          }
          now.textContent = txt;
        }
      }
    })();
  </script>
</Base>
