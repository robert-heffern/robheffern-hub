---
import Base from "../../layouts/Base.astro";
---
<Base title="The Sporting Zodiac — Rob Heffern" description="The sporting year as a wheel: the four major leagues' seasons, the daily rhythm of games, and the rare celestial alignments — equinox, perihelion, eclipse.">
  <main class="wrap">
    <p class="crumb"><a href="/sports/">← sports similarity</a></p>
    <header class="room-head">
      <p class="kicker">The Sporting Zodiac</p>
      <h1>The year, as the four leagues keep it.</h1>
      <p class="lede">
        Ancient people read the sky to know when to plant. We read the sports calendar.
        Here is the whole sporting year on one wheel — New Year at the top, the seasons
        as colored arcs, each day's games as spikes from the rim, and the rare alignments
        marked where they fall. <span id="z-now"></span>
      </p>
    </header>

    <div id="z-wheel" class="z-wheel"><p class="z-note">Reading the sky…</p></div>
    <div class="z-legend" id="z-legend"></div>

    <div class="z-glossary">
      <p><strong>Equinox</strong> — all four major leagues play on the same day. <strong>Super Equinox</strong> — plus college football.
      <strong>Perihelion</strong> — the single fullest day of the whole year, the most games the big four throw at once.
      <strong>Eclipse</strong> — the sky goes dark: no major-league games at all.
      <strong>First / Last Light</strong> — a sport's season opens or closes. <strong>The Turn</strong> — the midpoint of an offseason, when you stop mourning last season and start waiting on the next.</p>
    </div>
  </main>

  <style>
    .crumb { font-family: var(--sans); font-size: .8rem; margin: 0 0 2rem; }
    .room-head { margin-bottom: 2rem; }
    .kicker { font-family: var(--sans); text-transform: uppercase; letter-spacing: .28em; font-size: .72rem; color: var(--gold); margin: 0 0 .5rem; }
    h1 { font-size: clamp(1.8rem, 4vw, 2.6rem); font-weight: 500; margin: 0 0 1rem; }
    .lede { color: var(--muted); max-width: 40rem; font-size: 1.05rem; }
    .lede #z-now { color: var(--ink); }
    .z-wheel { display: flex; justify-content: center; margin: 1rem 0; }
    .z-wheel svg { width: 100%; max-width: 600px; height: auto; }
    .z-note { color: var(--muted); font-family: var(--sans); font-size: .85rem; padding: 3rem; }
    .z-legend { display: flex; flex-wrap: wrap; gap: .5rem 1.3rem; justify-content: center; margin: .5rem 0 2rem; font-family: var(--sans); font-size: .82rem; color: var(--muted); }
    .z-legend span { display: inline-flex; align-items: center; gap: .45rem; }
    .z-legend i { width: .7rem; height: .7rem; display: inline-block; }
    .z-glossary { max-width: 42rem; margin: 0 auto; color: var(--muted); font-size: .9rem; line-height: 1.7; border-top: 1px solid var(--line); padding-top: 1.3rem; }
    .z-glossary strong { color: var(--ink); font-weight: 600; }
  </style>

  <script is:inline>
    (function () {
      var SKY = "https://zodiac.palaich.net/sky.json";
      var NS = "http://www.w3.org/2000/svg";
      var ORDER = ["mlb", "nhl", "nba", "nfl"];
      var wheel = document.getElementById("z-wheel");

      function etToday(){ return new Intl.DateTimeFormat("en-CA",{timeZone:"America/New_York",year:"numeric",month:"2-digit",day:"2-digit"}).format(new Date()); }

      fetch(SKY).then(function (r){ if(!r.ok) throw 0; return r.json(); }).then(render)
        .catch(function(){ wheel.innerHTML = '<p class="z-note">The sky is clouded over just now.</p>'; });

      function render(data) {
        var TODAY = etToday();
        var leagues = data.leagues || {};
        var ev = data.events || {};

        // ---- fixed calendar dial: New Year at top, months counterclockwise ----
        function doyFrac(ds){
          var d=new Date(ds+"T12:00:00"), y=d.getFullYear();
          var start=new Date(y,0,1);
          var len=((y%4===0&&y%100!==0)||y%400===0)?366:365;
          return ((d-start)/86400000)/len;
        }
        function ang(ds){ return -90 - doyFrac(ds)*360; }      // counterclockwise, Jan at top
        function rad(a){ return a*Math.PI/180; }
        function pol(a,r){ return [cx+r*Math.cos(rad(a)), cy+r*Math.sin(rad(a))]; }
        function arcCCW(ds0, ds1, r){
          var a0=ang(ds0), a1=ang(ds1);
          var ccw=(((a0-a1)%360)+360)%360, large=ccw>180?1:0;
          var p0=pol(a0,r), p1=pol(a1,r);
          return "M "+p0[0].toFixed(1)+" "+p0[1].toFixed(1)+" A "+r+" "+r+" 0 "+large+" 0 "+p1[0].toFixed(1)+" "+p1[1].toFixed(1);
        }
        function mk(name, attrs, title){
          var e=document.createElementNS(NS,name);
          for(var k in attrs) e.setAttribute(k, attrs[k]);
          if(title){ var t=document.createElementNS(NS,"title"); t.textContent=title; e.appendChild(t); }
          return e;
        }

        var SZ=600, cx=SZ/2, cy=SZ/2;
        var R_RIM=186, SPIKE0=190, SPIKE_MAX=66;
        var BAND={mlb:178, nhl:170, nba:162, nfl:154};
        var muted="#a99a83", line="#352e26", gold="#c8a24a", ink="#ece3d4", bg="#14110f";

        var refYear2 = new Date(TODAY+"T12:00:00").getFullYear();

        var svg=mk("svg",{viewBox:"0 0 "+SZ+" "+SZ, role:"img", "aria-label":"The sporting year as a wheel"});

        svg.appendChild(mk("circle",{cx:cx,cy:cy,r:R_RIM,fill:"none",stroke:line,"stroke-width":1}));

        // month labels at mid-month, around the rim
        var MN=["January","February","March","April","May","June","July","August","September","October","November","December"];
        for(var m=0;m<12;m++){
          var mid=new Date(2027,m,15), ds=mid.toISOString().slice(0,10);
          var lp=pol(ang(ds), SPIKE0+SPIKE_MAX+16);
          var tx=mk("text",{x:lp[0].toFixed(1),y:lp[1].toFixed(1),"text-anchor":"middle","dominant-baseline":"middle","font-family":"var(--sans)","font-size":10,fill:muted,opacity:.75});
          tx.textContent=MN[m].slice(0,3); svg.appendChild(tx);
          var t0=pol(ang(new Date(2027,m,1).toISOString().slice(0,10)),R_RIM), t1=pol(ang(new Date(2027,m,1).toISOString().slice(0,10)),R_RIM+5);
          svg.appendChild(mk("line",{x1:t0[0].toFixed(1),y1:t0[1].toFixed(1),x2:t1[0].toFixed(1),y2:t1[1].toFixed(1),stroke:muted,"stroke-width":1,opacity:.35}));
        }

        // Pick the ONE season to show per league: the ongoing one if we're in it;
        // otherwise flip from the just-finished to the upcoming at the Turn (offseason midpoint).
        function pickSeason(L){
          var ss=(L.seasons||[]).slice().sort(function(a,b){return a.start<b.start?-1:1;});
          if(!ss.length) return null;
          for(var i=0;i<ss.length;i++){ if(ss[i].start<=TODAY && TODAY<=ss[i].end) return ss[i]; } // ongoing wins
          var prev=null,next=null;
          ss.forEach(function(s){ if(s.end<TODAY) prev=s; if(!next && s.start>TODAY) next=s; });
          if(prev && next){
            var turn=new Date((new Date(prev.end+"T12:00:00").getTime()+new Date(next.start+"T12:00:00").getTime())/2);
            return (new Date(TODAY+"T12:00:00") < turn) ? prev : next;   // before the Turn: still mourning last; after: waiting on next
          }
          return next || prev;
        }
        var picked={};
        ORDER.forEach(function(lg){ var L=leagues[lg]; if(L) picked[lg]=pickSeason(L); });

        // season bands — one arc per league
        ORDER.forEach(function(lg){
          var L=leagues[lg], s=picked[lg]; if(!L||!s) return;
          svg.appendChild(mk("path",{d:arcCCW(s.start,s.end,BAND[lg]),fill:"none",stroke:L.color,"stroke-width":5,"stroke-linecap":"round",opacity:.5}, L.label+" season: "+s.start+" → "+s.end));
        });

        // Aggregate games by calendar day — but only from each league's SHOWN season,
        // so (e.g.) next year's data never bleeds in until the Turn flips the season.
        var agg={}; // "MM-DD" -> {leagues:{lg:{count,date}}, total, sample}
        (data.days||[]).forEach(function(d){
          ORDER.forEach(function(lg){
            var s=picked[lg]; if(!s) return;
            if(d.date>=s.start && d.date<=s.end && (d[lg]||0)>0){
              var md=d.date.slice(5);
              if(!agg[md]) agg[md]={leagues:{},total:0,sample:d.date};
              agg[md].leagues[lg]={count:d[lg],date:d.date};
              agg[md].total+=d[lg];
              if(d.date>agg[md].sample) agg[md].sample=d.date;
            }
          });
        });
        var maxTot=1; for(var mk0 in agg){ if(agg[mk0].total>maxTot) maxTot=agg[mk0].total; }
        var scale=SPIKE_MAX/maxTot;
        function mdA(md){ return ang(refYear2+"-"+md); }
        function fmtMD(md){ return new Date(refYear2+"-"+md+"T12:00:00").toLocaleDateString("en-US",{month:"short",day:"numeric"}); }
        function tipFor(md){ var info=agg[md]; if(!info) return fmtMD(md)+" — no major-league games"; return fmtMD(md)+" — "+info.total+" game"+(info.total===1?"":"s")+" ("+ORDER.filter(function(lg){return info.leagues[lg];}).map(function(lg){return info.leagues[lg].count+" "+leagues[lg].label;}).join(", ")+")"; }

        // transparent hover targets for EVERY calendar day (so any day pops a tooltip)
        for(var dd=0; dd<365; dd++){
          var dobj=new Date(refYear2,0,1+dd);
          var md=("0"+(dobj.getMonth()+1)).slice(-2)+"-"+("0"+dobj.getDate()).slice(-2);
          var ah=mdA(md), h0=pol(ah,R_RIM), h1=pol(ah,SPIKE0+SPIKE_MAX);
          svg.appendChild(mk("line",{x1:h0[0].toFixed(1),y1:h0[1].toFixed(1),x2:h1[0].toFixed(1),y2:h1[1].toFixed(1),stroke:"transparent","stroke-width":4}, tipFor(md)));
        }
        // colored spikes, stacked outward, current season only
        for(var md2 in agg){
          var info=agg[md2], a2=mdA(md2), r=SPIKE0, tip=tipFor(md2);
          ORDER.forEach(function(lg){
            var e=info.leagues[lg]; if(!e) return;
            var len=e.count*scale, p0=pol(a2,r), p1=pol(a2,r+len), past=e.date<TODAY;
            svg.appendChild(mk("line",{x1:p0[0].toFixed(1),y1:p0[1].toFixed(1),x2:p1[0].toFixed(1),y2:p1[1].toFixed(1),stroke:leagues[lg].color,"stroke-width":1.6,"stroke-linecap":"round",opacity:past?.9:.45}, tip));
            r+=len;
          });
        }

        function nearestMD(ds){ // map an event date to the displayed occurrence angle
          return ang(ds);
        }

        // eclipse / equinox / conjunction glyphs on rim
        (ev.eclipses||[]).forEach(function(dte){ var p=pol(ang(dte),R_RIM); svg.appendChild(mk("circle",{cx:p[0].toFixed(1),cy:p[1].toFixed(1),r:3.4,fill:bg,stroke:muted,"stroke-width":1}, "Total Eclipse — no major-league games ("+dte+")")); });
        (ev.equinoxes||[]).forEach(function(dte){ var sup=(ev.superEquinoxes||[]).indexOf(dte)>=0; var p=pol(ang(dte),R_RIM); svg.appendChild(mk("circle",{cx:p[0].toFixed(1),cy:p[1].toFixed(1),r:sup?5:3.6,fill:gold,stroke:sup?ink:"none","stroke-width":sup?1.2:0}, (sup?"Super Equinox":"Sports Equinox")+" — "+dte)); });
        (ev.conjunctions||[]).forEach(function(c){ var p=pol(ang(c.date),R_RIM); svg.appendChild(mk("circle",{cx:p[0].toFixed(1),cy:p[1].toFixed(1),r:3.6,fill:"none",stroke:gold,"stroke-width":1.5}, "Conjunction — "+c.leagues.join(" + ").toUpperCase()+" ("+c.date+")")); });

        // Perihelion sunburst + label
        var per=ev.perihelion;
        if(per && per.date){
          var pp=pol(ang(per.date),R_RIM);
          svg.appendChild(mk("circle",{cx:pp[0].toFixed(1),cy:pp[1].toFixed(1),r:6,fill:gold}, "Perihelion — the fullest sky of the year ("+per.count+" games, "+per.date+")"));
          svg.appendChild(mk("circle",{cx:pp[0].toFixed(1),cy:pp[1].toFixed(1),r:10,fill:"none",stroke:gold,"stroke-width":1,opacity:.6}));
        }

        // First / Last Light (from the shown season) + the Turn, per league
        ORDER.forEach(function(lg){
          var L=leagues[lg], s=picked[lg]; if(!L) return;
          if(s){
            var a=ang(s.start), p0=pol(a,BAND[lg]-5), p1=pol(a,BAND[lg]+5);
            svg.appendChild(mk("line",{x1:p0[0].toFixed(1),y1:p0[1].toFixed(1),x2:p1[0].toFixed(1),y2:p1[1].toFixed(1),stroke:ink,"stroke-width":1.5,opacity:.8}, L.label+" First Light (season opens) — "+s.start));
            var a2=ang(s.end), q0=pol(a2,BAND[lg]-5), q1=pol(a2,BAND[lg]+5);
            svg.appendChild(mk("line",{x1:q0[0].toFixed(1),y1:q0[1].toFixed(1),x2:q1[0].toFixed(1),y2:q1[1].toFixed(1),stroke:muted,"stroke-width":1.5,opacity:.8}, L.label+" Last Light (season closes) — "+s.end));
          }
          if(s){ // the Turn = midpoint of this season's offseason (end → next start), computed per league
            var es=new Date(s.end+"T12:00:00"), ss=new Date(s.start+"T12:00:00");
            var ns=new Date(ss); ns.setFullYear(es.getFullYear()); if(ns<=es) ns.setFullYear(es.getFullYear()+1);
            var mid=new Date((es.getTime()+ns.getTime())/2);
            var mdT=("0"+(mid.getMonth()+1)).slice(-2)+"-"+("0"+mid.getDate()).slice(-2);
            var at=ang(refYear2+"-"+mdT), tp=pol(at,BAND[lg]);
            svg.appendChild(mk("circle",{cx:tp[0].toFixed(1),cy:tp[1].toFixed(1),r:2.6,fill:"none",stroke:L.color,"stroke-width":1.2}, L.label+" — the Turn (midway through the offseason), around "+mid.toLocaleDateString("en-US",{month:"long",day:"numeric"})));
          }
        });

        // TODAY marker
        var ta=ang(TODAY), t0=pol(ta,BAND.nfl-14), t1=pol(ta,SPIKE0+SPIKE_MAX+4);
        svg.appendChild(mk("line",{x1:t0[0].toFixed(1),y1:t0[1].toFixed(1),x2:t1[0].toFixed(1),y2:t1[1].toFixed(1),stroke:ink,"stroke-width":1.3,"stroke-dasharray":"2 3",opacity:.65}, "Today — "+TODAY));
        var tlp=pol(ta,SPIKE0+SPIKE_MAX+14);
        var tl=mk("text",{x:tlp[0].toFixed(1),y:tlp[1].toFixed(1),"text-anchor":"middle","dominant-baseline":"middle","font-family":"var(--sans)","font-size":9,fill:ink,"letter-spacing":"1"});
        tl.textContent="TODAY"; svg.appendChild(tl);

        // center: the year
        var yr=mk("text",{x:cx,y:cy,"text-anchor":"middle","dominant-baseline":"middle","font-family":"var(--serif)","font-size":22,fill:ink,opacity:.9});
        yr.textContent=new Date(TODAY+"T12:00:00").getFullYear(); svg.appendChild(yr);
        var nyl=mk("text",{x:cx,y:pol(-90,R_RIM)[1]-8,"text-anchor":"middle","font-family":"var(--sans)","font-size":8,fill:muted,"letter-spacing":"2"});
        nyl.textContent="NEW YEAR"; svg.appendChild(nyl);

        wheel.innerHTML=""; wheel.appendChild(svg);

        // legend
        var leg=document.getElementById("z-legend");
        if(leg){ leg.innerHTML="";
          ORDER.forEach(function(lg){ var L=leagues[lg]; if(!L)return; var s=document.createElement("span"); s.innerHTML='<i style="background:'+L.color+';border-radius:2px"></i>'+L.label; leg.appendChild(s); });
          [["Equinox",gold,"50%",""],["Perihelion",gold,"50%","box-shadow:0 0 0 2px "+gold+"55"],["Eclipse",bg,"50%","border:1px solid "+muted]].forEach(function(g){
            var s=document.createElement("span"); s.innerHTML='<i style="background:'+g[1]+';border-radius:'+g[2]+';'+g[3]+'"></i>'+g[0]; leg.appendChild(s);
          });
        }

        // "next event" sentence
        var now=document.getElementById("z-now");
        if(now){
          var up=[];
          var sup={}; (ev.superEquinoxes||[]).forEach(function(d){sup[d]=1;});
          var eqs=(ev.equinoxes||[]).slice().sort();
          if(eqs.length){
            var parts=eqs.map(function(d){ var past=d<TODAY; return (sup[d]?"★":"")+new Date(d+"T12:00:00").toLocaleDateString("en-US",{month:"short",day:"numeric"})+(past?" (past)":""); });
            now.textContent=eqs.length+" Sports Equinox"+(eqs.length===1?"":"es")+" in the year: "+parts.join(" · ")+(Object.keys(sup).length?"   ★ = Super Equinox.":".");
          } else {
            now.textContent="No Sports Equinox falls in view yet — the postseason schedule is still filling in.";
          }
        }
      }
    })();
  </script>
</Base>
