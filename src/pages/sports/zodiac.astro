---
import Base from "../../layouts/Base.astro";
---
<Base title="The Sporting Zodiac — Rob Heffern" description="Any year's sporting sky on one wheel: the leagues that existed, their seasons, the daily rhythm of games, and the year's rare alignments.">
  <main class="wrap">
    <p class="crumb"><a href="/sports/">← sports similarity</a></p>
    <header class="room-head">
      <p class="kicker">The Sporting Zodiac</p>
      <h1>Any year, as the leagues kept it.</h1>
      <p class="lede">
        Ancient people read the sky to know when to plant. We read the sports calendar.
        Pick a year and see its whole sporting sky — New Year at the top, each league's
        season as a colored arc, every day's games as spikes from the rim. <span id="z-now"></span>
      </p>
    </header>

    <div class="z-picker">
      <button id="z-prev" aria-label="Previous year">◀</button>
      <input id="z-year" type="number" inputmode="numeric" />
      <button id="z-next" aria-label="Next year">▶</button>
      <span id="z-range" class="z-range"></span>
    </div>

    <div class="z-controls">
      <div id="z-leagues" class="z-leagues"></div>
      <label class="z-winter"><input type="checkbox" id="z-winter" /> <span>Winter-spanning season <em>(Aug–Jul)</em></span></label>
    </div>

    <div id="z-wheel" class="z-wheel"><p class="z-note">Reading the sky…</p></div>
    <div class="z-legend" id="z-legend"></div>

    <div class="z-glossary">
      <p><strong>Perihelion</strong> — the single fullest day of the year, the most games played at once.
      <strong>Equinox</strong> — all four major leagues play the same day; a <strong>Super Equinox</strong> adds college football. (Only possible once all four majors exist.)
      <strong>Total Eclipse</strong> — the Equinox's opposite: a dark day inside the season when all four majors are idle at once, like the All-Star break. (Also only once all four exist.)
      <strong>First / Last Light</strong> — a league's season opens or closes.
      <strong>The Turn</strong> — the midpoint of a league's offseason, marked where its seasons change over.
      Each league is only drawn in the years it existed, so the wheel thins as you travel back toward baseball's lone early seasons — and the winter toggle re-anchors the wheel to Aug–Jul so a whole winter season reads as one arc.</p>
    </div>
  </main>

  <style>
    .crumb { font-family: var(--sans); font-size: .8rem; margin: 0 0 2rem; }
    .room-head { margin-bottom: 1.5rem; }
    .kicker { font-family: var(--sans); text-transform: uppercase; letter-spacing: .28em; font-size: .72rem; color: var(--gold); margin: 0 0 .5rem; }
    h1 { font-size: clamp(1.8rem, 4vw, 2.6rem); font-weight: 500; margin: 0 0 1rem; }
    .lede { color: var(--muted); max-width: 40rem; font-size: 1.05rem; }
    .lede #z-now { color: var(--ink); }
    .z-picker { display: flex; align-items: center; gap: .6rem; justify-content: center; margin: 0 0 1rem; font-family: var(--sans); }
    .z-picker button { background: var(--panel); color: var(--gold); border: 1px solid var(--line); border-radius: 8px; width: 2.2rem; height: 2.2rem; font-size: 1rem; cursor: pointer; }
    .z-picker button:hover { border-color: var(--gold); }
    .z-picker input { width: 5.5rem; text-align: center; font-size: 1.3rem; font-family: var(--serif); background: var(--panel); color: var(--ink); border: 1px solid var(--line); border-radius: 8px; padding: .3rem; }
    .z-range { color: var(--muted); font-size: .78rem; }
    .z-controls { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: .6rem 1.4rem; margin: 0 0 1rem; font-family: var(--sans); }
    .z-leagues { display: flex; flex-wrap: wrap; gap: .4rem; }
    .z-chip { display: inline-flex; align-items: center; gap: .4rem; cursor: pointer; border: 1px solid var(--line); border-radius: 999px; padding: .28rem .7rem; font-size: .8rem; color: var(--muted); user-select: none; transition: border-color .12s ease, color .12s ease, background .12s ease; }
    .z-chip:hover { border-color: var(--gold); }
    .z-chip input { display: none; }
    .z-chip i { width: .62rem; height: .62rem; border-radius: 2px; display: inline-block; opacity: .35; transition: opacity .12s ease; }
    .z-chip.on { color: var(--ink); background: color-mix(in srgb, var(--gold) 8%, var(--panel)); border-color: color-mix(in srgb, var(--gold) 40%, var(--line)); }
    .z-chip.on i { opacity: 1; }
    .z-winter { display: inline-flex; align-items: center; gap: .45rem; font-size: .8rem; color: var(--muted); cursor: pointer; }
    .z-winter em { font-style: normal; opacity: .7; }
    .z-winter input[disabled] { opacity: .4; }
    .z-winter:has(input[disabled]) { opacity: .45; cursor: not-allowed; }
    .z-wheel { display: flex; justify-content: center; margin: .5rem 0; min-height: 300px; }
    .z-wheel svg { width: 100%; max-width: 600px; height: auto; }
    .z-note { color: var(--muted); font-family: var(--sans); font-size: .85rem; padding: 3rem; }
    .z-legend { display: flex; flex-wrap: wrap; gap: .5rem 1.3rem; justify-content: center; margin: .5rem 0 2rem; font-family: var(--sans); font-size: .82rem; color: var(--muted); }
    .z-legend span { display: inline-flex; align-items: center; gap: .45rem; }
    .z-legend i { width: .7rem; height: .7rem; display: inline-block; }
    .z-glossary { max-width: 42rem; margin: 0 auto; color: var(--muted); font-size: .9rem; line-height: 1.7; border-top: 1px solid var(--line); padding-top: 1.3rem; }
    .z-glossary strong { color: var(--ink); font-weight: 600; }
  </style>

  <script is:inline>
    (function () {
      var BASE = "https://zodiac.palaich.net/years/";
      var NS = "http://www.w3.org/2000/svg";
      var ORDER = ["mlb","nhl","nba","nfl","cfb","nrl"];
      var BIG4 = ["mlb","nfl","nba","nhl"];
      var wheel = document.getElementById("z-wheel");
      var inp = document.getElementById("z-year");
      var rangeEl = document.getElementById("z-range");
      var winterBox = document.getElementById("z-winter");
      var cache = {};
      var MINY = 1871, MAXY = 2025, cur = 2025;
      var winter = false;         // winter-spanning (Aug–Jul) view
      var selected = {};          // league -> shown? (big4 default on, others off)

      function etToday(){ return new Intl.DateTimeFormat("en-CA",{timeZone:"America/New_York",year:"numeric",month:"2-digit",day:"2-digit"}).format(new Date()); }
      function pad(n){ return ("0"+n).slice(-2); }
      function isoOf(d){ return d.getFullYear()+"-"+pad(d.getMonth()+1)+"-"+pad(d.getDate()); }
      function yearLen(y){ return ((y%4===0&&y%100!==0)||y%400===0)?366:365; }
      function arcsFromDates(dts){
        if(!dts.length) return [];
        var arcs=[], s=dts[0], prev=dts[0];
        for(var i=1;i<dts.length;i++){ var c=dts[i];
          if((new Date(c+"T12:00:00")-new Date(prev+"T12:00:00"))/86400000 > 21){ arcs.push({start:s,end:prev}); s=c; }
          prev=c; }
        arcs.push({start:s,end:prev}); return arcs;
      }

      fetch(BASE + "index.json").then(function(r){ if(!r.ok) throw 0; return r.json(); })
        .then(function(ix){ MINY=ix.min; MAXY=ix.max; cur=MAXY; rangeEl.textContent="("+MINY+"–"+MAXY+")"; inp.min=MINY; inp.max=MAXY; inp.value=cur; show(); })
        .catch(function(){ wheel.innerHTML='<p class="z-note">The sky is clouded over just now.</p>'; });

      function clamp(y){ return Math.max(MINY, Math.min(MAXY, y)); }
      function go(y){ y=clamp(y); cur=y; inp.value=y; show(); }
      document.getElementById("z-prev").onclick=function(){ go(cur-1); };
      document.getElementById("z-next").onclick=function(){ go(cur+1); };
      inp.onchange=function(){ var v=parseInt(inp.value,10); if(!isNaN(v)) go(v); };
      winterBox.onchange=function(){ winter=winterBox.checked; show(); };

      // fetch any years we still need, then build + render the current view
      function show(){
        if(winter && cur+1 > MAXY){ winter=false; winterBox.checked=false; }
        winterBox.disabled = (cur+1 > MAXY);
        var years=[cur]; if(winter) years.push(cur+1);
        var missing=years.filter(function(y){ return !cache[y] && y>=MINY && y<=MAXY; });
        var draw=function(){ var v=buildView(); if(v) render(v); else wheel.innerHTML='<p class="z-note">No data for '+(winter?(cur+"/"+(cur+1)):cur)+'.</p>'; };
        if(!missing.length){ draw(); return; }
        wheel.innerHTML='<p class="z-note">Reading '+(winter?(cur+"/"+(cur+1)):cur)+'…</p>';
        Promise.all(missing.map(function(y){
          return fetch(BASE+y+".json").then(function(r){ return r.ok?r.json():null; }).then(function(d){ if(d) cache[y]=d; }).catch(function(){});
        })).then(draw);
      }

      // normalize whatever's selected (single calendar year, or Aug→Jul window) into
      // one shape render() can draw: {label, year, winter, anchorISO, winDays, leagues, present, events}
      function buildView(){
        if(!winter){
          var d=cache[cur]; if(!d) return null;
          return { winter:false, year:cur, label:""+cur, anchorISO:cur+"-01-01", winDays:yearLen(cur),
                   leagues:d.leagues||{}, present:d.leaguesPresent||Object.keys(d.leagues||{}), events:d.events||{} };
        }
        var a=cache[cur], b=cache[cur+1]; if(!a||!b) return null;
        var lo=cur+"-08-01", hi=(cur+1)+"-08-01";                 // [lo, hi)
        var leagues={}, present=[];
        ORDER.forEach(function(lg){
          var days=[];
          [a,b].forEach(function(src){ var L=(src.leagues||{})[lg]; if(!L) return; (L.days||[]).forEach(function(x){ if(x.date>=lo && x.date<hi) days.push(x); }); });
          if(!days.length) return;
          days.sort(function(p,q){ return p.date<q.date?-1:1; });
          var meta=(a.leagues&&a.leagues[lg])||(b.leagues&&b.leagues[lg]);
          leagues[lg]={ label:meta.label, color:meta.color, days:days, seasons:arcsFromDates(days.map(function(x){return x.date;})) };
          present.push(lg);
        });
        // recompute the sky's events over the window, from big-4 (+cfb for super)
        var perDay={};
        present.forEach(function(lg){ if(BIG4.indexOf(lg)<0 && lg!=="cfb") return;
          leagues[lg].days.forEach(function(x){ (perDay[x.date]=perDay[x.date]||{})[lg]=x.count; }); });
        var peri={date:null,count:-1}, equ=[], sup=[];
        Object.keys(perDay).sort().forEach(function(ds){ var row=perDay[ds];
          var tot=BIG4.reduce(function(s,lg){ return s+(row[lg]||0); },0);
          if(tot>peri.count) peri={date:ds,count:tot};
          if(BIG4.every(function(lg){ return (row[lg]||0)>0; })){ equ.push(ds); if((row.cfb||0)>0) sup.push(ds); }
        });
        return { winter:true, year:cur, label:cur+"/"+(cur+1), anchorISO:lo,
                 winDays:Math.round((new Date(hi+"T12:00:00")-new Date(lo+"T12:00:00"))/86400000),
                 leagues:leagues, present:present, events:{perihelion:peri,equinoxes:equ,superEquinoxes:sup,eclipses:[]} };
      }

      function render(view) {
        var leagues = view.leagues, present = view.present, ev = view.events || {};
        var TODAY = etToday();

        // default selection: big-4 on, others (CFB/NRL) off; remember user's choice across years
        present.forEach(function(lg){ if(!(lg in selected)) selected[lg] = BIG4.indexOf(lg)>=0; });
        var shown = present.filter(function(lg){ return selected[lg]; });

        var anchorMs=new Date(view.anchorISO+"T12:00:00").getTime(), winDays=view.winDays;
        var anchorY=parseInt(view.anchorISO.slice(0,4),10), anchorM=parseInt(view.anchorISO.slice(5,7),10)-1;
        function frac(ds){ return ((new Date(ds+"T12:00:00").getTime()-anchorMs)/86400000)/winDays; }
        function ang(ds){ return -90 - frac(ds)*360; }
        function rad(a){ return a*Math.PI/180; }
        function pol(a,r){ return [cx+r*Math.cos(rad(a)), cy+r*Math.sin(rad(a))]; }
        function arcCCW(ds0, ds1, r){ var a0=ang(ds0), a1=ang(ds1); var ccw=(((a0-a1)%360)+360)%360, large=ccw>180?1:0; var p0=pol(a0,r), p1=pol(a1,r); return "M "+p0[0].toFixed(1)+" "+p0[1].toFixed(1)+" A "+r+" "+r+" 0 "+large+" 0 "+p1[0].toFixed(1)+" "+p1[1].toFixed(1); }
        function mk(name, attrs, title){ var e=document.createElementNS(NS,name); for(var k in attrs) e.setAttribute(k,attrs[k]); if(title){ var t=document.createElementNS(NS,"title"); t.textContent=title; e.appendChild(t); } return e; }

        var SZ=600, cx=SZ/2, cy=SZ/2;
        var R_RIM=186, SPIKE0=190, SPIKE_MAX=70;
        var muted="#a99a83", line="#352e26", gold="#c8a24a", ink="#ece3d4", bg="#14110f";
        var BAND={}; shown.forEach(function(lg,i){ BAND[lg]=178-i*9; });

        // spike scale over the shown leagues
        var maxTot=1, dayTotal={};
        shown.forEach(function(lg){ (leagues[lg].days||[]).forEach(function(x){ dayTotal[x.date]=(dayTotal[x.date]||0)+x.count; }); });
        for(var dk in dayTotal){ if(dayTotal[dk]>maxTot) maxTot=dayTotal[dk]; }
        var scale=SPIKE_MAX/maxTot;
        var Y=view.year, LAB=view.label;

        var svg=mk("svg",{viewBox:"0 0 "+SZ+" "+SZ, role:"img", "aria-label":"The "+LAB+" sporting year as a wheel"});
        svg.appendChild(mk("circle",{cx:cx,cy:cy,r:R_RIM,fill:"none",stroke:line,"stroke-width":1}));

        // month labels + ticks (walk 12 months forward from the anchor)
        var MN=["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];
        for(var i=0;i<12;i++){
          var mm=anchorM+i, my=anchorY+Math.floor(mm/12), md=((mm%12)+12)%12;
          var ds15=my+"-"+pad(md+1)+"-15", ds1=my+"-"+pad(md+1)+"-01";
          var lp=pol(ang(ds15), SPIKE0+SPIKE_MAX+16);
          var tx=mk("text",{x:lp[0].toFixed(1),y:lp[1].toFixed(1),"text-anchor":"middle","dominant-baseline":"middle","font-family":"var(--sans)","font-size":10,fill:muted,opacity:.75}); tx.textContent=MN[md]; svg.appendChild(tx);
          var t0=pol(ang(ds1),R_RIM), t1=pol(ang(ds1),R_RIM+5);
          svg.appendChild(mk("line",{x1:t0[0].toFixed(1),y1:t0[1].toFixed(1),x2:t1[0].toFixed(1),y2:t1[1].toFixed(1),stroke:muted,"stroke-width":1,opacity:.35}));
        }

        // season bands
        shown.forEach(function(lg){
          var L=leagues[lg];
          (L.seasons||[]).forEach(function(s){
            svg.appendChild(mk("path",{d:arcCCW(s.start,s.end,BAND[lg]),fill:"none",stroke:L.color,"stroke-width":5,"stroke-linecap":"round",opacity:.5}, L.label+": "+s.start+" → "+s.end));
          });
        });

        // per-day counts per league for tooltips
        var perLg={}; shown.forEach(function(lg){ perLg[lg]={}; (leagues[lg].days||[]).forEach(function(x){ perLg[lg][x.date]=x.count; }); });
        function tipFor(ds){
          var parts=[], tot=0;
          shown.forEach(function(lg){ var c=perLg[lg][ds]; if(c){ parts.push(c+" "+leagues[lg].label); tot+=c; } });
          var lbl=new Date(ds+"T12:00:00").toLocaleDateString("en-US",{month:"short",day:"numeric"});
          return tot? lbl+" — "+tot+" game"+(tot===1?"":"s")+" ("+parts.join(", ")+")" : lbl+" — no games";
        }

        // transparent hover targets for every day in the window
        for(var dd=0; dd<winDays; dd++){
          var dobj=new Date(anchorMs + dd*86400000); var ds=isoOf(dobj);
          var ah=ang(ds), h0=pol(ah,R_RIM), h1=pol(ah,SPIKE0+SPIKE_MAX);
          svg.appendChild(mk("line",{x1:h0[0].toFixed(1),y1:h0[1].toFixed(1),x2:h1[0].toFixed(1),y2:h1[1].toFixed(1),stroke:"transparent","stroke-width":4}, tipFor(ds)));
        }

        // spikes, stacked outward by league
        var dayKeys={}; shown.forEach(function(lg){ (leagues[lg].days||[]).forEach(function(x){ dayKeys[x.date]=1; }); });
        Object.keys(dayKeys).forEach(function(ds){
          var a=ang(ds), r=SPIKE0, tip=tipFor(ds);
          shown.forEach(function(lg){
            var c=perLg[lg][ds]; if(!c) return;
            var len=c*scale, p0=pol(a,r), p1=pol(a,r+len);
            svg.appendChild(mk("line",{x1:p0[0].toFixed(1),y1:p0[1].toFixed(1),x2:p1[0].toFixed(1),y2:p1[1].toFixed(1),stroke:leagues[lg].color,"stroke-width":1.6,"stroke-linecap":"round",opacity:.9}, tip));
            r+=len;
          });
        });

        // ---- the sky's events, computed from the day data so they behave the same in
        //      the calendar-year view, the winter-spanning view, and early single-league
        //      years. Events are big-4 based (the "sky"), independent of the toggles. ----
        var big4here = present.filter(function(lg){ return BIG4.indexOf(lg)>=0; });
        var b4day={}, b4set={}, cfbday={};
        big4here.forEach(function(lg){ (leagues[lg].days||[]).forEach(function(x){
          b4day[x.date]=(b4day[x.date]||0)+x.count; (b4set[x.date]=b4set[x.date]||{})[lg]=1; }); });
        if(present.indexOf("cfb")>=0){ (leagues.cfb.days||[]).forEach(function(x){ cfbday[x.date]=x.count; }); }

        // Perihelion — the single fullest big-4 day
        var per={date:null,count:-1};
        Object.keys(b4day).forEach(function(ds){ if(b4day[ds]>per.count) per={date:ds,count:b4day[ds]}; });

        // Equinox / Super Equinox — only possible once all four majors exist
        var equ=[], sup=[];
        if(big4here.length===4){
          Object.keys(b4set).sort().forEach(function(ds){
            if(BIG4.every(function(lg){ return b4set[ds][lg]; })){ equ.push(ds); if((cfbday[ds]||0)>0) sup.push(ds); }
          });
        }

        // Total Eclipse — the Equinox's twin: a dark day INSIDE a big-4 season arc when
        //   every major is idle at once (the All-Star break, a holiday). Only meaningful
        //   once all four majors exist, so — like the Equinox — it isn't marked before then,
        //   which also keeps early single-league wheels clean. Arc-bounded: the empty
        //   offseason never counts.
        var eclSet={};
        if(big4here.length===4){
          big4here.forEach(function(lg){ (leagues[lg].seasons||[]).forEach(function(s){
            var a=new Date(s.start+"T12:00:00").getTime(), b=new Date(s.end+"T12:00:00").getTime();
            for(var t=a;t<=b;t+=86400000){ var ds=isoOf(new Date(t)); if(!b4day[ds]) eclSet[ds]=1; }
          }); });
        }
        var ecl=Object.keys(eclSet).sort();

        // Perihelion glyph
        if(per.date){
          var pp=pol(ang(per.date),R_RIM);
          svg.appendChild(mk("circle",{cx:pp[0].toFixed(1),cy:pp[1].toFixed(1),r:6,fill:gold}, "Perihelion — the fullest day of "+LAB+" ("+per.count+" games, "+per.date+")"));
          svg.appendChild(mk("circle",{cx:pp[0].toFixed(1),cy:pp[1].toFixed(1),r:10,fill:"none",stroke:gold,"stroke-width":1,opacity:.6}));
        }
        // Eclipse + Equinox glyphs
        ecl.forEach(function(d){ var p=pol(ang(d),R_RIM); svg.appendChild(mk("circle",{cx:p[0].toFixed(1),cy:p[1].toFixed(1),r:3.4,fill:bg,stroke:muted,"stroke-width":1}, "Total Eclipse — every major league idle ("+d+")")); });
        equ.forEach(function(d){ var isup=sup.indexOf(d)>=0; var p=pol(ang(d),R_RIM); svg.appendChild(mk("circle",{cx:p[0].toFixed(1),cy:p[1].toFixed(1),r:isup?5:3.6,fill:gold,stroke:isup?ink:"none","stroke-width":isup?1.2:0}, (isup?"Super Equinox — all four majors + college football":"Sports Equinox — all four majors play")+" ("+d+")")); });

        // First / Last Light (season opens / closes) + the Turn (offseason midpoint).
        // Ticks on the artificial window edges are skipped; the Turn sits in each
        // in-window gap between a league's consecutive arcs.
        shown.forEach(function(lg){
          var L=leagues[lg], arcs=L.seasons||[];
          arcs.forEach(function(s,ai){
            if(frac(s.start) > 0.03){ var a=ang(s.start), p0=pol(a,BAND[lg]-5), p1=pol(a,BAND[lg]+5);
              svg.appendChild(mk("line",{x1:p0[0].toFixed(1),y1:p0[1].toFixed(1),x2:p1[0].toFixed(1),y2:p1[1].toFixed(1),stroke:ink,"stroke-width":1.5,opacity:.8}, L.label+" First Light — "+s.start)); }
            if(frac(s.end) < 0.97){ var a2=ang(s.end), q0=pol(a2,BAND[lg]-5), q1=pol(a2,BAND[lg]+5);
              svg.appendChild(mk("line",{x1:q0[0].toFixed(1),y1:q0[1].toFixed(1),x2:q1[0].toFixed(1),y2:q1[1].toFixed(1),stroke:muted,"stroke-width":1.5,opacity:.8}, L.label+" Last Light — "+s.end)); }
            if(ai < arcs.length-1){
              var g0=new Date(s.end+"T12:00:00").getTime(), g1=new Date(arcs[ai+1].start+"T12:00:00").getTime();
              var mid=isoOf(new Date((g0+g1)/2)), ma=ang(mid), cm=pol(ma,BAND[lg]);
              svg.appendChild(mk("circle",{cx:cm[0].toFixed(1),cy:cm[1].toFixed(1),r:2.8,fill:bg,stroke:L.color,"stroke-width":1.2,opacity:.95}, L.label+" Turn — offseason midpoint ("+mid+")"));
            }
          });
        });

        // today marker (only when today falls inside the window)
        var tf=frac(TODAY);
        if(tf>=0 && tf<1){
          var ta=ang(TODAY), t0=pol(ta,R_RIM-26), t1=pol(ta,SPIKE0+SPIKE_MAX+4);
          svg.appendChild(mk("line",{x1:t0[0].toFixed(1),y1:t0[1].toFixed(1),x2:t1[0].toFixed(1),y2:t1[1].toFixed(1),stroke:ink,"stroke-width":1.3,"stroke-dasharray":"2 3",opacity:.65}, "Today — "+TODAY));
        }

        // center: the label + top anchor marker
        var yr=mk("text",{x:cx,y:cy,"text-anchor":"middle","dominant-baseline":"middle","font-family":"var(--serif)","font-size":view.winter?24:30,fill:ink,opacity:.92}); yr.textContent=LAB; svg.appendChild(yr);
        var nyl=mk("text",{x:cx,y:pol(-90,R_RIM)[1]-8,"text-anchor":"middle","font-family":"var(--sans)","font-size":8,fill:muted,"letter-spacing":"2"}); nyl.textContent=view.winter?"AUG 1":"NEW YEAR"; svg.appendChild(nyl);

        wheel.innerHTML=""; wheel.appendChild(svg);

        // league toggle chips (reflect what existed this year, remember selection)
        var chips=document.getElementById("z-leagues"); chips.innerHTML="";
        present.forEach(function(lg){
          var L=leagues[lg], on=!!selected[lg];
          var lab=document.createElement("label"); lab.className="z-chip"+(on?" on":"");
          lab.innerHTML='<input type="checkbox" '+(on?"checked":"")+'><i style="background:'+L.color+'"></i>'+L.label;
          lab.querySelector("input").onchange=function(e){ selected[lg]=e.target.checked; show(); };
          chips.appendChild(lab);
        });

        // legend (only shown leagues) + perihelion key
        var leg=document.getElementById("z-legend"); leg.innerHTML="";
        shown.forEach(function(lg){ var L=leagues[lg]; var s=document.createElement("span"); s.innerHTML='<i style="background:'+L.color+';border-radius:2px"></i>'+L.label; leg.appendChild(s); });
        var pe=document.createElement("span"); pe.innerHTML='<i style="background:'+gold+';border-radius:50%"></i>Perihelion'; leg.appendChild(pe);
        if(equ.length){ var eq=document.createElement("span"); eq.innerHTML='<i style="background:'+gold+';border-radius:50%;box-shadow:0 0 0 1px '+ink+'"></i>Equinox'; leg.appendChild(eq); }
        if(ecl.length){ var ec=document.createElement("span"); ec.innerHTML='<i style="background:'+bg+';border-radius:50%;box-shadow:inset 0 0 0 1px '+muted+'"></i>Eclipse'; leg.appendChild(ec); }

        // lede summary
        var now=document.getElementById("z-now");
        if(now){
          if(shown.length){
            var names=shown.map(function(lg){return leagues[lg].label;}).join(", ");
            var txt=LAB+": "+shown.length+" league"+(shown.length===1?"":"s")+" shown ("+names+").";
            if(per.date){ txt+=" Fullest day: "+new Date(per.date+"T12:00:00").toLocaleDateString("en-US",{month:"long",day:"numeric"})+", "+per.count+" games."; }
            if(equ.length){ txt+=" "+equ.length+" Equinox"+(equ.length===1?"":"es")+(sup.length?" ("+sup.length+" Super)":"")+"."; }
            if(ecl.length){ txt+=" "+ecl.length+" Eclipse"+(ecl.length===1?"":"s")+"."; }
            now.textContent=txt;
          } else { now.textContent=LAB+": pick a league to show."; }
        }
      }
    })();
  </script>
</Base>
