---
import Base from "../../../layouts/Base.astro";
import { getCollection } from "astro:content";
import syn from "../../../data/syntopicon.json";

export async function getStaticPaths() {
  return syn.ideas.map((idea) => ({ params: { idea: idea.slug }, props: { idea } }));
}

const { idea } = Astro.props;

// essays that live in this room
const essays = await getCollection("essays");
const entryBySlug = {};
for (const e of essays) entryBySlug[e.slug] = e;
const mySlugs = syn.essays_by_idea[idea.name] || [];
const myEssays = mySlugs.map((s) => entryBySlug[s]).filter(Boolean);

// backlinks: subtopics elsewhere that point at this idea
const backlinks = (syn.backlinks[idea.name] || []).slice();
backlinks.sort((a, b) => a.from_idea.localeCompare(b.from_idea) || a.sub.localeCompare(b.sub));
const essaysBySub = syn.essays_by_sub;
---
<Base title={`${idea.name} — The Syntopicon`} description={`The great idea of ${idea.name}: essays, and every thread across the Syntopicon that leads here.`}>
  <main class="wrap">
    <p class="crumb"><a href="/essays/">← the Syntopicon</a></p>
    <header class="room-head">
      <p class="kicker">Great Idea</p>
      <h1>{idea.name}</h1>
      <p class="stat">
        {idea.essay_count > 0 && <span>{idea.essay_count} essay{idea.essay_count === 1 ? "" : "s"}</span>}
        {idea.essay_count > 0 && <span class="dot">·</span>}
        <span>{idea.backlink_count} thread{idea.backlink_count === 1 ? "" : "s"} lead here</span>
        <span class="dot">·</span>
        <span>{idea.subtopic_count} subtopics in Adler's outline</span>
      </p>
    </header>

    {myEssays.length > 0 && (
      <section class="block">
        <h2>Essays in this room</h2>
        <ul class="essays">
          {myEssays.map((e) => (
            <li>
              <a href={`/essays/${e.slug}/`}>
                <span class="title">{e.data.title}</span>
                {e.data.subidea && <span class="sub">{e.data.subidea}</span>}
                {e.data.excerpt && <span class="teaser">{e.data.excerpt}</span>}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="block">
      <h2>Threads that lead here</h2>
      <p class="block-note">
        Subtopics elsewhere in the Syntopicon whose argument reaches into {idea.name}.
        The lit ones have an essay you can read now.
      </p>
      <ul class="threads">
        {backlinks.map((bl) => {
          const linked = essaysBySub[bl.sub];
          return (
            <li class={linked ? "thread lit" : "thread"}>
              <a class="thread-from" href={`/essays/idea/${syn.idea_slug[bl.from_idea]}/`}>{bl.sub}</a>
              {bl.blurb && <span class="thread-blurb">{bl.blurb}</span>}
              {linked && linked.map((s) => (
                <a class="thread-essay" href={`/essays/${s}/`}>read: {(entryBySlug[s] && entryBySlug[s].data.title) || s} →</a>
              ))}
            </li>
          );
        })}
      </ul>
    </section>
  </main>

  <style>
    .crumb { font-family: var(--sans); font-size: .8rem; margin: 0 0 2rem; }
    .room-head { margin-bottom: 2.5rem; }
    .kicker { font-family: var(--sans); text-transform: uppercase; letter-spacing: .28em; font-size: .72rem; color: var(--muted); margin: 0 0 .5rem; }
    h1 { font-size: clamp(2rem, 5vw, 3rem); font-weight: 500; margin: 0 0 .7rem; }
    .stat { font-family: var(--sans); font-size: .85rem; color: var(--muted); }
    .stat .dot { margin: 0 .5rem; opacity: .5; }

    .block { margin: 2.8rem 0; }
    .block h2 {
      font-family: var(--sans); font-size: .78rem; font-weight: 600;
      text-transform: uppercase; letter-spacing: .18em; color: var(--gold);
      border-bottom: 1px solid var(--line); padding-bottom: .5rem; margin: 0 0 1rem;
    }
    .block-note { color: var(--muted); font-size: .95rem; max-width: 38rem; margin: 0 0 1.4rem; }

    .essays { list-style: none; margin: 0; padding: 0; }
    .essays li { margin: 0 0 1.2rem; }
    .essays a { display: block; color: var(--ink); }
    .essays a:hover { text-decoration: none; }
    .essays a:hover .title { text-decoration: underline; text-decoration-color: var(--gold); }
    .essays .title { display: block; font-size: 1.3rem; }
    .essays .sub { display: block; font-family: var(--sans); font-size: .72rem; letter-spacing: .1em; text-transform: uppercase; color: var(--gold); margin-top: .15rem; }
    .essays .teaser { display: block; color: var(--muted); font-size: .95rem; margin-top: .2rem; }

    .threads { list-style: none; margin: 0; padding: 0; }
    .thread { padding: .9rem 0; border-bottom: 1px solid var(--line); }
    .thread-from { font-family: var(--sans); font-size: .8rem; font-weight: 600; letter-spacing: .06em; color: var(--muted); }
    .thread.lit .thread-from { color: var(--ink); }
    .thread-from:hover { color: var(--gold); text-decoration: none; }
    .thread-blurb { display: block; font-size: 1.02rem; margin: .25rem 0 .1rem; color: var(--ink); }
    .thread-essay { display: inline-block; font-family: var(--sans); font-size: .8rem; color: var(--gold); margin-top: .2rem; }
  </style>
</Base>
