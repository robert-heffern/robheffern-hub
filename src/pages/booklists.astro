---
import Base from "../layouts/Base.astro";
import data from "../data/booklists.json";
const totalLists = data.sections.reduce((n,s)=>n+s.lists.length,0);
const totalBooks = data.sections.reduce((n,s)=>n+s.lists.reduce((m,l)=>m+l.books.length,0),0);
---
<Base title="Booklists — Rob Heffern" description="Every reading list I keep — curated, by decade, and a very deep reference shelf.">
  <main class="wrap">
    <p class="crumb"><a href="/">← the cabinet</a></p>
    <header class="room-head">
      <p class="kicker">Booklists</p>
      <h1>The lists I keep.</h1>
      <p class="lede">
        {totalLists} lists, {totalBooks.toLocaleString()} books. Some are mine, hand-curated;
        the deep shelf at the bottom is a reference collection I've been hoarding. Every book has a
        "find it" link. Pick a list.
      </p>
    </header>

    {data.sections.map((sec) => (
      <section class="sec">
        <h2>{sec.name} <span class="cnt">{sec.lists.length}</span></h2>
        <div class="lists">
          {sec.lists.map((l) => (
            <a class="listcard" href={`/booklists/${l.slug}/`}>
              <span class="lt">{l.title}</span>
              <span class="lb">{l.books.length} books</span>
            </a>
          ))}
        </div>
      </section>
    ))}
  </main>
  <style>
    .crumb { font-family: var(--sans); font-size: .8rem; margin: 0 0 2rem; }
    .room-head { margin-bottom: 2.5rem; }
    .kicker { font-family: var(--sans); text-transform: uppercase; letter-spacing: .28em; font-size: .72rem; color: var(--muted); margin: 0 0 .5rem; }
    h1 { font-size: clamp(1.8rem, 4vw, 2.6rem); font-weight: 500; margin: 0 0 1rem; }
    .lede { color: var(--muted); max-width: 38rem; font-size: 1.1rem; }
    .sec { margin: 2.5rem 0; }
    .sec h2 { font-family: var(--sans); font-size: .8rem; font-weight: 600; text-transform: uppercase; letter-spacing: .16em; color: var(--gold); border-bottom: 1px solid var(--line); padding-bottom: .5rem; margin: 0 0 1rem; }
    .cnt { color: var(--muted); font-weight: 400; }
    .lists { display: grid; gap: .6rem; grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr)); }
    .listcard { display: flex; justify-content: space-between; align-items: baseline; gap: .6rem; background: var(--panel); border: 1px solid var(--line); border-radius: 8px; padding: .7rem .9rem; color: var(--ink); }
    .listcard:hover { border-color: var(--gold); text-decoration: none; }
    .lt { font-size: .98rem; line-height: 1.25; }
    .lb { font-family: var(--sans); font-size: .68rem; color: var(--muted); white-space: nowrap; }
  </style>
</Base>
